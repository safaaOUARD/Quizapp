<?xml version="1.0" encoding="utf-8"?>
<!--
    FICHIER : res/drawable/bg_radio_option.xml
    Fond arrondi avec bordure pour les options RadioButton
    À placer dans : app/src/main/res/drawable/bg_radio_option.xml

    Rendu : carte blanche avec bordure grise claire et coins arrondis à 10dp
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond blanc -->
    <solid android:color="#FFFFFF" />

    <!-- Bordure grise claire -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- Coins arrondis -->
    <corners android:radius="10dp" />

    <!-- Ombre interne légère via padding (optionnel) -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>